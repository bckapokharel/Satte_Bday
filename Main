<script>
/* =========================================================
   ✏️  EDIT THIS PART — everything personal lives here
   ========================================================= */
const CONFIG = {
  name: "Sachita",
  from: "Your favourite person",
  candles: 5,
  reasons: [
    "Your laugh can fix a bad day from across the room.",
    "You remember the tiny things people only mention once.",
    "You're brave, even on the days you feel scared.",
    "You turn the most ordinary plans into adventures.",
    "You're kind to people who can't do anything for you.",
    "You're just really, really fun to be around."
  ],
  letter: [
    "Another year of you in the world, and honestly, the world is lucky.",
    "I hope this year brings you slow mornings, loud laughs, good food, and every single thing you wished for on those candles.",
    "Thank you for being exactly who you are. Never change the important parts.",
    "Happy birthday. Go have the best day ever."
  ]
};
/* ========================================================= */

const $ = (id) => document.getElementById(id);
const slides = [...document.querySelectorAll(".slide")];
const done = slides.map(() => false);
const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
let current = 0;

document.title = `Happy Birthday, ${CONFIG.name} 🎂`;
$("giftTitle").textContent = `Psst, ${CONFIG.name}.`;

/* ---------- Navigation ---------- */
const back = $("back"), next = $("next"), dotsEl = $("dots");
slides.forEach(() => dotsEl.appendChild(Object.assign(document.createElement("span"), { className: "dot" })));

function go(i) {
  if (i < 0 || i >= slides.length) return;
  current = i;
  slides.forEach((s, k) => {
    s.classList.toggle("active", k === i);
    s.setAttribute("aria-hidden", k !== i);
    s.inert = k !== i;
  });
  [...dotsEl.children].forEach((d, k) => d.classList.toggle("on", k === i));
  back.disabled = i === 0;
  next.style.visibility = i === slides.length - 1 ? "hidden" : "visible";
  next.disabled = !done[i];
  next.classList.toggle("ready", done[i]);
  slides[i].scrollTop = 0;
}
function complete(i) {
  done[i] = true;
  if (i === current) { next.disabled = false; next.classList.add("ready"); }
}
back.addEventListener("click", () => go(current - 1));
next.addEventListener("click", () => go(current + 1));
document.addEventListener("keydown", (e) => {
  if (e.key === "ArrowRight" && !next.disabled) go(current + 1);
  if (e.key === "ArrowLeft") go(current - 1);
});

/* ---------- Sound (tiny synth, no files needed) ---------- */
let audio, soundOn = true;
function tone(freq, dur = .2, type = "sine", vol = .12, delay = 0) {
  if (!soundOn) return;
  try {
    audio = audio || new (window.AudioContext || window.webkitAudioContext)();
    const t = audio.currentTime + delay;
    const o = audio.createOscillator(), g = audio.createGain();
    o.type = type;
    o.frequency.setValueAtTime(freq, t);
    g.gain.setValueAtTime(vol, t);
    g.gain.exponentialRampToValueAtTime(.001, t + dur);
    o.connect(g).connect(audio.destination);
    o.start(t); o.stop(t + dur);
  } catch (e) { /* sound is optional */ }
}
const chime = () => [523, 659, 784, 1047].forEach((f, k) => tone(f, .35, "triangle", .1, k * .11));
const popSound = () => tone(180 + Math.random() * 80, .09, "square", .05);
const blowSound = () => tone(240, .3, "sine", .06);
$("sound").addEventListener("click", (e) => {
  soundOn = !soundOn;
  e.currentTarget.textContent = soundOn ? "🔊" : "🔇";
  e.currentTarget.setAttribute("aria-label", soundOn ? "Turn sound off" : "Turn sound on");
});

/* ---------- Confetti ---------- */
const cv = $("confetti"), cx = cv.getContext("2d");
const colors = ["#FF7EB6", "#E0457B", "#FFE08A", "#9FE3C6", "#FFFFFF", "#C9A7FF"];
let parts = [], running = false;
function resize() {
  const dpr = window.devicePixelRatio || 1;
  cv.width = innerWidth * dpr; cv.height = innerHeight * dpr;
  cx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
resize(); addEventListener("resize", resize);

function burst(x, y, n = 70, falling = false) {
  if (reduceMotion) n = Math.min(n, 12);
  for (let k = 0; k < n; k++) {
    parts.push({
      x, y,
      vx: (Math.random() - .5) * (falling ? 3 : 11),
      vy: falling ? Math.random() * 2 : -Math.random() * 10 - 3,
      r: Math.random() * 6 + 5,
      rot: Math.random() * 6, vr: (Math.random() - .5) * .3,
      color: colors[(Math.random() * colors.length) | 0],
      heart: Math.random() < .22
    });
  }
  if (!running) { running = true; requestAnimationFrame(loop); }
}
function rain() { for (let k = 0; k < 8; k++) setTimeout(() => burst(Math.random() * innerWidth, -20, 28, true), k * 200); }
function loop() {
  cx.clearRect(0, 0, innerWidth, innerHeight);
  parts = parts.filter((p) => p.y < innerHeight + 40);
  for (const p of parts) {
    p.vy += .22; p.vx *= .99; p.x += p.vx; p.y += p.vy; p.rot += p.vr;
    cx.save(); cx.translate(p.x, p.y); cx.rotate(p.rot); cx.fillStyle = p.color;
    if (p.heart) { cx.font = `${p.r * 2.4}px sans-serif`; cx.textAlign = "center"; cx.fillText("♥", 0, p.r); }
    else cx.fillRect(-p.r / 2, -p.r / 4, p.r, p.r / 2);
    cx.restore();
  }
  if (parts.length) requestAnimationFrame(loop); else running = false;
}
const centerOf = (el) => { const r = el.getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; };

/* ---------- Bouncy headline ---------- */
function bounceText(el, text) {
  el.textContent = "";
  el.setAttribute("aria-label", text);
  let n = 0;
  text.split(" ").forEach((word, wi, all) => {
    const w = document.createElement("span");
    w.className = "word"; w.setAttribute("aria-hidden", "true");
    [...word].forEach((ch) => {
      const s = document.createElement("span");
      s.className = "w"; s.textContent = ch; s.style.animationDelay = `${n++ * 45}ms`;
      w.appendChild(s);
    });
    el.appendChild(w);
    if (wi < all.length - 1) el.appendChild(document.createTextNode(" "));
  });
}

/* ---------- 1. Gift ---------- */
$("gift").addEventListener("click", (e) => {
  const gift = e.currentTarget;
  if (gift.classList.contains("open")) return;
  gift.classList.add("open");
  gift.setAttribute("aria-label", "Present opened");
  chime();
  const [x, y] = centerOf(gift);
  burst(x, y - 30, 100);
  bounceText($("giftTitle"), `Happy birthday, ${CONFIG.name}!`);
  $("giftText").textContent = "Today is all yours. And there's more waiting for you.";
  $("giftHint").textContent = "Tap Next 💖";
  complete(0);
});

/* ---------- 2. Candles ---------- */
let candlesLeft = CONFIG.candles;
const candleHint = $("candleHint");
const candleLabel = () => candleHint.textContent = `${candlesLeft} candle${candlesLeft === 1 ? "" : "s"} to go`;
for (let k = 0; k < CONFIG.candles; k++) {
  const c = document.createElement("div");
  c.className = "candle";
  const f = document.createElement("button");
  f.className = "flame";
  f.setAttribute("aria-label", `Blow out candle ${k + 1}`);
  f.style.animationDelay = `${-Math.random()}s`;
  f.addEventListener("click", () => {
    c.classList.add("out");
    blowSound();
    candlesLeft--;
    if (candlesLeft > 0) return candleLabel();
    candleHint.textContent = "Wish sealed. Not telling anyone 🤫";
    setTimeout(chime, 250);
    const [x, y] = centerOf(document.querySelector(".cake"));
    burst(x, y - 60, 110);
    complete(1);
  });
  c.appendChild(f);
  $("candles").appendChild(c);
}
candleLabel();

/* ---------- 3. Balloons ---------- */
const balloonColors = ["#FF7EB6", "#FFD23F", "#9FE3C6", "#C9A7FF", "#FF9E7A", "#7CC8FF"];
let balloonsLeft = CONFIG.reasons.length;
const balloonHint = $("balloonHint");
const balloonLabel = () => balloonHint.textContent = `${balloonsLeft} balloon${balloonsLeft === 1 ? "" : "s"} left`;
CONFIG.reasons.forEach((reason, k) => {
  const b = document.createElement("button");
  const color = balloonColors[k % balloonColors.length];
  b.className = "balloon";
  b.style.setProperty("--c", color);
  b.style.setProperty("--d", `${-k * .55}s`);
  b.setAttribute("aria-label", `Pop balloon ${k + 1}`);
  b.addEventListener("click", () => {
    const [x, y] = centerOf(b);
    b.classList.add("popped");
    setTimeout(() => b.classList.add("gone"), 230);
    popSound();
    burst(x, y, 26);
    const note = document.createElement("div");
    note.className = "note";
    note.style.setProperty("--c", color);
    note.textContent = reason;
    $("notes").prepend(note);
    balloonsLeft--;
    if (balloonsLeft > 0) return balloonLabel();
    balloonHint.textContent = "That's all of them. (There are way more reasons, though.)";
    chime();
    complete(2);
  });
  $("balloons").appendChild(b);
});
balloonLabel();

/* ---------- 4. Letter ---------- */
const letter = $("letter");
letter.innerHTML = `<h3></h3>${CONFIG.letter.map(() => "<p></p>").join("")}<div class="sign"></div>`;
letter.querySelector("h3").textContent = `Dear ${CONFIG.name},`;
letter.querySelectorAll("p").forEach((p, k) => p.textContent = CONFIG.letter[k]);
letter.querySelector(".sign").textContent = `Love, ${CONFIG.from} 💖`;
const again = Object.assign(document.createElement("button"), { className: "btn primary again", textContent: "Start again" });
again.addEventListener("click", () => location.reload());
letter.appendChild(again);

$("envelope").addEventListener("click", (e) => {
  const env = e.currentTarget;
  if (env.classList.contains("open")) return;
  env.classList.add("open");
  chime();
  setTimeout(() => {
    env.classList.add("gone");
    $("letterTitle").textContent = "Happy birthday 🎈";
    $("letterText").textContent = "";
    letter.classList.add("show");
    rain();
    complete(3);
  }, 900);
});

go(0);
</script>
</body>
</html>
